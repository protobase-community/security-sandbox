{
  "name": "property-management",
  "version": "0.0.0",
  "description": "A property management back office built with Protobase: owners, properties, leases, rent and maintenance",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protobase-community/property-management.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:up": "test -f .env || cp .env.example .env; docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "protobase run db/migrate.ts",
    "db:seed:base": "protobase run seed/base.ts",
    "db:seed": "protobase run seed/cli.ts",
    "db:fingerprint": "protobase run db/fingerprint.ts",
    "db:reset": "protobase run db/drop.ts && protobase run db/migrate.ts && protobase run seed/cli.ts --scale small",
    "typecheck": "protobase types && tsc --noEmit",
    "test": "protobase types && vitest run",
    "protobase": "protobase",
    "build": "protobase build",
    "serve": "protobase build && protobase serve dist",
    "dev": "protobase dev"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@protobase/cli": "^0.50.1",
    "@protobase/config": "^0.50.1",
    "@protobase/layout": "^0.50.1",
    "@protobase/schema": "^0.50.1",
    "@protobase/server": "^0.50.1",
    "@protobase/ui": "^0.50.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
